      switches="--rev ${mcver}"
      ;;
    F)
      flavor="Fabric"
      url="https://maven.fabricmc.net/net/fabricmc/fabric-installer/1.0.0/fabric-installer-1.0.0.jar"
      jarname="fabric-server-launch.jar"
      switches="server -mcversion ${mcver} -downloadMinecraft"
      ;;
    R)
      flavor="Forge"
      if [[ $mcver == "26.2" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/26.2-65.1.0/forge-26.2-65.1.0-installer.jar"
      elif [[ $mcver == "1.21" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.21-51.0.26/forge-1.21-51.0.26-installer.jar"
      elif [[ $mcver == "1.20.6" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.20.6-50.1.12/forge-1.20.6-50.1.12-installer.jar"
      elif [[ $mcver == "1.20.4" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.20.4-49.1.0/forge-1.20.4-49.1.0-installer.jar"
      elif [[ $mcver == "1.20.2" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.20.2-48.1.0/forge-1.20.2-48.1.0-installer.jar"
      elif [[ $mcver == "1.20.1" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.20.1-47.4.10/forge-1.20.1-47.4.10-installer.jar"
      elif [[ $mcver == "1.19.4" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.19.4-45.3.0/forge-1.19.4-45.3.0-installer.jar"
      elif [[ $mcver == "1.19.3" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.19.3-44.1.23/forge-1.19.3-44.1.23-installer.jar"
      elif [[ $mcver == "1.19.2" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.19.2-43.3.13/forge-1.19.2-43.3.13-installer.jar"
      elif [[ $mcver == "1.19" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.19-41.1.0/forge-1.19-41.1.0-installer.jar"
      elif [[ $mcver == "1.18.2" ]]; then
        url="https://maven.minecraftforge.net/net/minecraftforge/forge/1.18.2-40.2.21/forge-1.18.2-40.2.21-installer.jar"
      elif [[ $mcver == "1.18.1" ]]; then
